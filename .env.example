# İletişim formu (src/app/api/contact/route.ts) — Resend ile e-posta gönderimi.
# Bu değişkenler ayarlanmazsa form çalışmaz ve kullanıcıya "doğrudan e-posta at" mesajı döner.

# https://resend.com → API Keys
RESEND_API_KEY=

# Mesajların düşeceği adres (varsayılan: site config'teki e-posta)
CONTACT_TO=

# Gönderen adresi. Resend'de doğrulanmış domain gerekir.
# Test için "Portfolio <onboarding@resend.dev>" kullanılabilir.
CONTACT_FROM=
